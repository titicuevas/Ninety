PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Producción (cutover): CLIENT_URL=https://www.getninety.app
# Orígenes CORS extra (coma): apex + Railway; www/apex/Railway ya van por defecto en código
# CORS_ORIGINS=https://getninety.app,https://ninety.up.railway.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SOLO backend — NUNCA en frontend ni en GitHub
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Para migraciones automáticas desde terminal (opcional — también puedes usar el SQL Editor)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

FOOTBALL_DATA_API_KEY=your-football-data-api-key

# Push Web (opcional en local; obligatorio en prod para alertas del navegador)
# Generar SOLO en local: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Guardar SOLO en backend/.env y en variables de Railway (servicio API).
# NUNCA: frontend, GitHub, commits, capturas, chats.
# VAPID_PUBLIC_KEY se expone al navegador vía API (es pública por diseño).
# VAPID_PRIVATE_KEY es secreta — solo proceso backend.
# Publicar en Railway sin filtrar secretos: npm run vapid:set-railway
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@ninety.app

# Auth recovery: en Supabase Dashboard → Authentication → URL Configuration
# añade Redirect URL: {CLIENT_URL}/auth/reset-password
# (CLIENT_URL de abajo debe coincidir con el origen del frontend en prod)
# Usuario de prueba (solo local — npm run seed:test-user / seed:demo)
# TEST_USER_EMAIL=demo@ninety.app
# TEST_USER_PASSWORD=your-test-password
