# Supabase (frontend — solo claves públicas)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_API_URL=http://localhost:3001

# Backend — ver backend/.env.example (secret key, football API, VAPID)
#
# Push Web en producción (Railway):
# 1. Genera claves en local: node -e "console.log(require('web-push').generateVAPIDKeys())"
# 2. Guárdalas en backend/.env (nunca en frontend ni en git)
# 3. Publícalas en Railway: npm run vapid:set-railway
# 4. Aplica migraciones push_subscriptions + comments update en Supabase
# 5. Redirect URL de recovery: {CLIENT_URL}/auth/reset-password en Supabase Auth → URL Configuration
