{
  "name": "ninety-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node serve.mjs",
    "typecheck": "tsc --noEmit",
    "check:dead-code": "knip",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 --test src/**/*.test.ts",
    "test": "node --import tsx --test src/**/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.68.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.483.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "knip": "6.32.2",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-x64-gnu": "0.143.0"
  }
}
